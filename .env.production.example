# .env.production.example - Secrets belong only in the ignored .env.production file.
TRAIL_HOST=trail.YOUR-STATIC-IP.sslip.io
JWT_SECRET=
TRAIL_AGENT_MODE=bedrock
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEMO_MODE=true
PUBLIC_DEMO=true
COOKIE_SECURE=true
AGENT_TIMEOUT_SECONDS=60
AGENT_INTERVAL_SECONDS=30
MAX_ACTIVE_SESSIONS=10
MAX_DEMO_STARTS_PER_HOUR=60
DEMO_SESSION_LIFETIME_SECONDS=600
CHECKIN_TIMEOUT_SECONDS=15
